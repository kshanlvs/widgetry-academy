# Copy to .env for local runs. Never commit real values.
PORT=8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jobs
DB_PASSWORD=
DB_NAME=widgetry_jobs
# Cloud SQL (instead of DB_HOST/PORT): DB_SOCKET=/cloudsql/flutter-in-10-days:asia-south1:widgetry-jobs
# Hosted MySQL that needs TLS (TiDB Cloud, Aiven): DB_SSL=1
FIREBASE_PROJECT_ID=flutter-in-10-days
ADMIN_UIDS=E4edbAvcdwTdkTdNwcdWneVWe572
HASH_SALT=
JOB_LIFETIME_DAYS=30
# LLM chat (Claude API key from console.anthropic.com; set it as a Railway variable too)
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-haiku-5-5
# CHAT_MAX_TOKENS=800
# CHAT_HISTORY_LIMIT=20
# CHAT_DAILY_LIMIT=30
MIGRATE_ON_START=1
