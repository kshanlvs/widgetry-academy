{
  "name": "widgetry-jobs-api",
  "version": "0.1.0",
  "private": true,
  "description": "Widgetry Jobs: Flutter-only jobs board and talent network API",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "node dist/migrate.js",
    "migrate:dev": "tsx src/migrate.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "knowledge": "node scripts/build-knowledge.mjs",
    "sync-shared": "node scripts/sync-shared.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "docx": "^9.14.0",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "mammoth": "^1.9.1",
    "mysql2": "^3.24.6",
    "pdfjs-dist": "^4.10.38",
    "playwright-core": "^1.56.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
