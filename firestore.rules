rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ADMIN: paste your admin account's UID here (Firebase console → Authentication → Users → User UID).
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['E4edbAvcdwTdkTdNwcdWneVWe572'];
    }

    // One registration record per student. Document ID = the student's Firebase UID.
    match /registrations/{uid} {

      // Students can read only their own registration. The admin can read all.
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();

      // Create: Registration with initial status "registered"
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'level', 'experience', 'batch',
          'status', 'emailVerified', 'phoneVerified', 'amountPaid',
          'paymentId', 'payStatus', 'plan', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 100
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.level is string
        && request.resource.data.experience is string
        && request.resource.data.status == 'registered'
        && request.resource.data.emailVerified == false
        && request.resource.data.phoneVerified == false
        && request.resource.data.amountPaid == 0
        && request.resource.data.payStatus == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Students can update their own profile (name, phone, level, experience, updatedAt only)
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'level', 'experience', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      // Admin: can update payment, status, and notes
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paymentId', 'amountPaid', 'payStatus', 'status', 'plan', 'notes', 'adminUpdatedAt'
        ]);

      // Delete: Students can delete only if not verified, Admin can delete any
      allow delete: if (request.auth != null && request.auth.uid == uid && resource.data.emailVerified == false) || isAdmin();
    }

    // ===== COURSES COLLECTION =====
    // Anyone can read courses, only admin can create/update/delete
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ===== ENROLLMENTS COLLECTION =====
    // Students can read/manage their own enrollments, admin can read all
    match /enrollments/{enrollmentId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.uid || isAdmin()
      );
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.keys().hasOnly(['uid', 'courseId', 'status', 'enrolledAt', 'progress']);
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.uid || isAdmin()
      );
    }

    // ===== PAYMENTS COLLECTION =====
    // Students can read their own payments, admin can read all and create/update
    match /payments/{paymentId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.uid || isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    // WACollab Mentor applications: anyone can apply (no login); only the admin can read or manage.
      // WACollab Mentor applications: anyone can apply (no login); only the admin can read or manage.
    match /mentorApplications/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','phone','city','company','role','experience','linkedin','portfolio','skills','course','availability','mode','teaching','video','pitch','consent','status','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 1 && request.resource.data.name.size() < 100
        && request.resource.data.email is string && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') && request.resource.data.email.size() < 150
        && request.resource.data.phone is string && request.resource.data.phone.matches('^\\+[1-9][0-9]{9,14}$')
        && request.resource.data.city is string && request.resource.data.city.size() < 60
        && request.resource.data.company is string && request.resource.data.company.size() > 0 && request.resource.data.company.size() <= 100
        && request.resource.data.role is string && request.resource.data.role.size() > 0 && request.resource.data.role.size() <= 100
        && request.resource.data.experience is string && request.resource.data.experience.size() < 20
        && request.resource.data.linkedin is string && request.resource.data.linkedin.matches('^https?://([a-zA-Z]+\\.)?linkedin\\.com/.+') && request.resource.data.linkedin.size() <= 200
        && request.resource.data.portfolio is string && request.resource.data.portfolio.size() <= 200
        && request.resource.data.skills is list && request.resource.data.skills.size() > 0 && request.resource.data.skills.size() <= 10
        && request.resource.data.course is string && request.resource.data.course.size() > 0 && request.resource.data.course.size() <= 200
        && request.resource.data.availability is list && request.resource.data.availability.size() > 0 && request.resource.data.availability.size() <= 3
        && request.resource.data.mode is string && request.resource.data.mode.size() < 20
        && request.resource.data.teaching is string && request.resource.data.teaching.size() < 60
        && request.resource.data.video is string && request.resource.data.video.size() <= 200
        && request.resource.data.pitch is string && request.resource.data.pitch.size() >= 20 && request.resource.data.pitch.size() <= 1000
        && request.resource.data.consent == true
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      
      // PUBLIC: Anyone can read approved mentors (for showcase). ADMIN: Can read all.
      allow read: if isAdmin() || resource.data.status == 'approved';
      
      allow delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','notes','adminUpdatedAt']);
    
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
