rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ADMIN: paste your admin account's UID here (Firebase console → Authentication → Users → User UID).
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['Raht6ud3vqc3XDmFOFLetFP6b8t2'];
    }

    // One registration record per student. Document ID = the student's Firebase UID.
    match /registrations/{uid} {

      // Students can read only their own registration. The admin can read all.
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();

      // Create: Registration with initial status "registered"
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'level', 'experience', 'batch',
          'status', 'emailVerified', 'phoneVerified', 'amountPaid',
          'paymentId', 'payStatus', 'plan', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 100
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.level is string
        && request.resource.data.experience is string
        && request.resource.data.status == 'registered'
        && request.resource.data.emailVerified == false
        && request.resource.data.phoneVerified == false
        && request.resource.data.amountPaid == 0
        && request.resource.data.payStatus == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Students can update their own profile (name, phone, level, experience, updatedAt only)
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'level', 'experience', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      // Admin: can update payment, status, and notes
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paymentId', 'amountPaid', 'payStatus', 'status', 'plan', 'notes', 'adminUpdatedAt'
        ]);

      // Delete: Students can delete only if not verified, Admin can delete any
      allow delete: if (request.auth != null && request.auth.uid == uid && resource.data.emailVerified == false) || isAdmin();
    }

    // ===== COURSES COLLECTION =====
    // Anyone can read courses, only admin can create/update/delete
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ===== ENROLLMENTS COLLECTION =====
    // Students can read/manage their own enrollments, admin can read all
    match /enrollments/{enrollmentId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.uid || isAdmin()
      );
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.keys().hasOnly(['uid', 'courseId', 'status', 'enrolledAt', 'progress']);
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.uid || isAdmin()
      );
    }

    // ===== PAYMENTS COLLECTION =====
    // Students can read their own payments, admin can read all and create/update
    match /payments/{paymentId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.uid || isAdmin()
      );
      allow create, update, delete: if isAdmin();
    }

    // Mentor applications: authenticated users can apply; only the admin can read or manage.
    match /mentorApplications/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid','name','email','phone','company','role','experience','linkedin','skills','course','bio','availability','status','createdAt','updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 1 && request.resource.data.name.size() < 100
        && request.resource.data.email is string && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') && request.resource.data.email.size() < 150
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() < 20
        && request.resource.data.company is string && request.resource.data.company.size() > 0 && request.resource.data.company.size() <= 100
        && request.resource.data.role is string && request.resource.data.role.size() > 0 && request.resource.data.role.size() <= 100
        && request.resource.data.experience is integer && request.resource.data.experience >= 0 && request.resource.data.experience <= 50
        && request.resource.data.linkedin is string && request.resource.data.linkedin.size() <= 200
        && request.resource.data.skills is list && request.resource.data.skills.size() > 0 && request.resource.data.skills.size() <= 10
        && request.resource.data.course is string && request.resource.data.course.size() > 0 && request.resource.data.course.size() <= 500
        && request.resource.data.bio is string && request.resource.data.bio.size() > 0 && request.resource.data.bio.size() <= 500
        && request.resource.data.availability is string && request.resource.data.availability.size() > 0 && request.resource.data.availability.size() <= 50
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Users can read their own application; ADMIN can read all; PUBLIC can read approved mentors only
      allow read: if request.auth != null && request.auth.uid == resource.data.uid || isAdmin() || resource.data.status == 'approved';

      // Users can delete their own pending applications only
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid && resource.data.status == 'pending' || isAdmin();

      // Admin: can update status and add notes
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','notes','adminUpdatedAt']);
    
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
